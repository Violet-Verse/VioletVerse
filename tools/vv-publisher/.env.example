# Copy to .env (already git-ignored) and fill in.
VV_SITE_URL=https://violetverse.io
# Your admin/contributor email from the Airtable users table
VV_EMAIL=
# Same value as ADMIN_LOGIN_SECRET in the site's Vercel env vars
VV_ADMIN_KEY=
# Same value as NEXT_PUBLIC_IMGBB_KEY (only needed for local images)
IMGBB_KEY=
# Optional: lets --ai write a missing subtitle / TL;DR / category
ANTHROPIC_API_KEY=
